# ===== 配置模板 =====
# 复制为 .env.dev / .env.prod 后按需填写，真实文件已被 .gitignore 排除，不会进入版本库。
# 用法：.\start.ps1 [dev|prod] 或 ./start.sh [dev|prod]，脚本会设置 ENVIRONMENT
# 从而让 NoneBot 加载对应的 .env.<ENVIRONMENT> 文件（见 .env 中 ENVIRONMENT 的说明）。

HOST=127.0.0.1
PORT=1927
LOG_LEVEL=INFO

# 机器人管理员 QQ 号列表，例如 SUPERUSERS=["123456789"]
SUPERUSERS=[]

# OneBot 连接鉴权，需与协议端（NapCat 等）配置的 token 一致，留空表示不鉴权
ONEBOT_ACCESS_TOKEN=

# --- basic 插件 ---
# 阻塞名单（QQ 号字符串列表），例如 BLOCKLIST=["123456789"]
BLOCKLIST=[]
# 管理员（QQ 号字符串列表）
ADMIN=[]

# --- custom_quotes 插件 ---
# 语录素材根目录（quotes.json 中各词条的 dir 是相对它的子目录）
QUOTE_PATH=
# 触发词/回复配置文件
QUOTE_CONFIG_FILEPATH=./assets/custom_quotes/quotes.json

# --- morning_night_greeting 插件 ---
MNGREETING_REPLIES_FILEPATH=./assets/morning_night_greeting/replies.json
MNGREETING_COOLDOWN=20

# --- Minecraft 适配器（鹊桥 QueQiao）---
# 反向连接（推荐）：鹊桥主动连 ws://<bot地址>:1927/minecraft/ws，此处只需填鉴权 token
# 需与鹊桥 config.yml 的 access_token 一致，留空表示不鉴权
MINECRAFT_ACCESS_TOKEN=
# 正向连接（可选）：由 bot 主动连鹊桥的 WS Server，键为服务器名
# MINECRAFT_WS_URLS={"survival": ["ws://127.0.0.1:8080/minecraft/ws"]}

# --- mc_bridge 插件 ---
# 服务器名，需与鹊桥 config.yml 的 server_name 完全一致
MC_SERVER_NAME=
# 与服务器互通的 QQ 群号，例如 MC_GROUPS=["657148784"]
MC_GROUPS=[]
# MC -> QQ 事件开关
MC_SYNC_CHAT=true
MC_SYNC_JOIN=true
MC_SYNC_QUIT=true
MC_SYNC_DEATH=true
MC_SYNC_ACHIEVEMENT=true
# QQ -> MC 单条消息最大长度
MC_MSG_MAX_LENGTH=200
